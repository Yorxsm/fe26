{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fe2vi-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Served at fe2vi.space and www.fe2vi.space as Workers Custom Domains.
  "workers_dev": false,
  "routes": [
    { "pattern": "fe2vi.space", "custom_domain": true },
    { "pattern": "www.fe2vi.space", "custom_domain": true }
  ],
  "vars": {
    "FE2VI_NETWORK": "arena",
    "NEXT_PUBLIC_FE2VI_API_URL": "https://api.fe2vi.space",
    "NEXT_PUBLIC_FE2VI_CHAIN": "testnet",
    "NEXT_PUBLIC_FE2VI_RPC_URL": "https://rpc.testnet.fastnear.com",
    "NEXT_PUBLIC_FE2VI_PASSPORT_ID": "passport.fe2vidisp7a3c.testnet",
    "NEXT_PUBLIC_FE2VI_MARKET_ID": "market.fe2vidisp7a3c.testnet",
    "NEXT_PUBLIC_FE2VI_ESCROW_ID": "heist.fe2vidisp7a3c.testnet",
    "NEXT_PUBLIC_FE2VI_EXPLORER": "https://testnet.nearblocks.io",
    "NEXT_PUBLIC_FE2VI_WALLET": "https://testnet.mynearwallet.com"
  }
}
