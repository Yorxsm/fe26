{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fe2vi-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "FE2VI_NETWORK": "testnet"
  }
}
