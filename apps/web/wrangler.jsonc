{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fe2vi-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // fe2vi.space and www.fe2vi.space are the intro. testnet.fe2vi.space is the full app.
  "workers_dev": false,
  "routes": [
    { "pattern": "fe2vi.space", "custom_domain": true },
    { "pattern": "www.fe2vi.space", "custom_domain": true },
    { "pattern": "testnet.fe2vi.space", "custom_domain": true }
  ],
  "vars": {
    "FE2VI_NETWORK": "testnet",
    "NEXT_PUBLIC_FE2VI_API_URL": "https://api.fe2vi.space"
  }
}
