# Copy to .env for local CLI use. Never commit the copy.
# Fe26 foundation is testnet-only. The CLI refuses RPC URLs that contain "mainnet".

FE26_RPC_URL=https://rpc.testnet.near.org
FE26_ACCOUNT_ID=your-account.testnet
# ed25519 secret for the signer above. Leave empty to dry-run.
FE26_SIGNER_SECRET_KEY=
FE26_FACTORY_ID=factory.fe26.testnet
FE26_REGISTRY_ID=registry.fe26.testnet
FE26_HEIST_ID=heist.fe26.testnet
FE26_API_URL=http://127.0.0.1:8787

# Public URL baked into the Next.js client. Not a secret.
NEXT_PUBLIC_FE26_API_URL=http://127.0.0.1:8787
NEXT_PUBLIC_FE26_NETWORK=testnet
