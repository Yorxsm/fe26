# Copy to .env for local CLI use. Never commit the copy.
# fe2VI foundation is testnet-only. The CLI refuses RPC URLs that contain "mainnet".

FE2VI_RPC_URL=https://rpc.testnet.near.org
FE2VI_ACCOUNT_ID=your-account.testnet
# ed25519 secret for the signer above. Leave empty to dry-run.
FE2VI_SIGNER_SECRET_KEY=
FE2VI_FACTORY_ID=factory.fe2vi.testnet
FE2VI_REGISTRY_ID=registry.fe2vi.testnet
FE2VI_HEIST_ID=heist.fe2vi.testnet
FE2VI_API_URL=http://127.0.0.1:8787

# Public URL baked into the Next.js client. Not a secret.
NEXT_PUBLIC_FE2VI_API_URL=http://127.0.0.1:8787
NEXT_PUBLIC_FE2VI_NETWORK=testnet
NEXT_PUBLIC_FE2VI_FACTORY_ID=factory.fe2vi.testnet
NEXT_PUBLIC_FE2VI_REGISTRY_ID=registry.fe2vi.testnet
NEXT_PUBLIC_FE2VI_HEIST_ID=heist.fe2vi.testnet

# Public site name only. Do not buy or configure DNS from this repo.
NEXT_PUBLIC_FE2VI_SITE=https://fe2vi.space

# NEAR Intents Agent API. The hosted service is mainnet and moves real funds.
# Leave the key empty. Set FE2VI_INTENTS_LIVE=1 only for a dry quote you mean to send.
# Never commit a real naa_ key or ngt_ grant token.
NEAR_INTENTS_AGENT_API_KEY=
NEAR_INTENTS_AGENT_API_URL=https://api.agentsonintents.com
FE2VI_INTENTS_LIVE=0
