# Wrangler local variables for workers/api. Copy to workers/api/.dev.vars.
# Leave the ingest token empty for an open relay. Every response is labeled unverified.
# Set a token only in your local file or with `wrangler secret put`. Do not commit it.

FE2VI_NETWORK=testnet
FE2VI_INGEST_TOKEN=
# Intents partner key is a Wrangler secret, not a var. The Worker uses it only to read policy status.
# Leave empty here to disable live linking.
NEAR_INTENTS_AGENT_API_KEY=
NEAR_INTENTS_AGENT_API_URL=https://api.agentsonintents.com
FE2VI_INTENTS_LIVE=0
